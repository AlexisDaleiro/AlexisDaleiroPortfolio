---
import "@fontsource-variable/bodoni-moda/opsz.css";
import "@fontsource-variable/schibsted-grotesk";
import { existsSync } from "node:fs";
import "../styles/global.css";
import { copy, links, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = copy[lang];
const [first, ...rest] = t.looks;
const total = String(t.looks.length).padStart(2, "0");
const n = (i: number) => String(i + 1).padStart(2, "0");
const canonical = new URL(lang === "es" ? "/" : "/en/", Astro.site);
// CV links render only once the PDF is in public/, so the build never ships a 404.
const hasCv = existsSync(`public${links.cv}`);
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.title}</title>
    <meta name="description" content={t.description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es" href={new URL("/", Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL("/en/", Astro.site)} />
    <meta property="og:title" content={t.title} />
    <meta property="og:description" content={t.description} />
    <meta property="og:image" content={new URL(first.shot!.desktop, Astro.site)} />
    <meta name="theme-color" content="#ecedeb" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>document.documentElement.classList.add("js")</script>
  </head>
  <body>
    <a class="skip" href="#main">{lang === "es" ? "Saltar al contenido" : "Skip to content"}</a>

    <header class="nav">
      <a class="nav__name" href={lang === "es" ? "/" : "/en/"}>Alexis Daleiro</a>
      <nav aria-label={lang === "es" ? "Principal" : "Main"}>
        <ul class="nav__links">
          <li><a href="#trabajos">{t.nav.work}</a></li>
          <li><a href="#indice">{t.nav.index}</a></li>
          <li><a href="#contacto">{t.nav.contact}</a></li>
        </ul>
      </nav>
      <div class="nav__end">
        <p class="nav__lang label">
          <span aria-current="true">{t.lang.toUpperCase()}</span>
          <span aria-hidden="true">/</span>
          <a href={t.other.href} hreflang={t.other.label.toLowerCase()} lang={t.other.label.toLowerCase()} aria-label={t.other.name}>{t.other.label}</a>
        </p>
        {hasCv && <a class="nav__cv label" href={links.cv} download>{t.nav.cv}</a>}
      </div>
    </header>

    <main id="main">
      <section class="hero" id="trabajos" aria-labelledby="name">
        <figure class="plate plate--hero reveal" data-look>
          <div class="plate__frame">
            <img class="plate__img plate__img--desktop" src={first.shot!.desktop} alt={first.shot!.alt} width="2108" height="1180" fetchpriority="high" />
            <img class="plate__img plate__img--mobile" src={first.shot!.mobile} alt={first.shot!.altMobile} width="780" height="1688" loading="lazy" />
          </div>
        </figure>

        <div class="hero__copy">
          <p class="hero__role label">{t.hero.role}</p>
          <p class="hero__line">{t.hero.line}</p>
          <div class="hero__actions">
            {hasCv ? (
              <>
                <a class="button" href={links.cv} download>{t.hero.cv}</a>
                <a class="textlink" href={`mailto:${links.email}`}>{t.hero.write}</a>
              </>
            ) : (
              <>
                <a class="button" href={`mailto:${links.email}`}>{t.hero.write}</a>
                <a class="textlink" href={links.linkedin} target="_blank" rel="noopener">LinkedIn<svg class="arrow" viewBox="0 0 12 12" aria-hidden="true"><path d="M3 9 9 3M4 3h5v5" /></svg></a>
              </>
            )}
          </div>
        </div>

        <h1 class="hero__name display" id="name">Alexis Daleiro</h1>

        <div class="caption caption--hero">
          <p class="label"><span class="caption__n">01 / {total}</span> {first.name} · {first.kind}</p>
          <div class="views" role="group" aria-label={first.name}>
            <button type="button" class="views__btn label" aria-pressed="true" data-view="desktop">{t.look.desktop}</button>
            <button type="button" class="views__btn label" aria-pressed="false" data-view="mobile">{t.look.mobile}</button>
          </div>
        </div>
      </section>

      <section class="look look--detail" aria-labelledby={`look-${first.id}`}>
        <div class="look__text">
          <h2 class="look__name display" id={`look-${first.id}`}>{first.name}</h2>
          <p class="look__body">{first.body}</p>
          <ul class="stack" aria-label="Stack">{first.stack.map((s) => <li>{s}</li>)}</ul>
          <p class="look__links">
            <a class="textlink" href={first.site} target="_blank" rel="noopener">{t.look.site}<svg class="arrow" viewBox="0 0 12 12" aria-hidden="true"><path d="M3 9 9 3M4 3h5v5" /></svg></a>
            <a class="textlink" href={first.repo} target="_blank" rel="noopener">{t.look.code}<svg class="arrow" viewBox="0 0 12 12" aria-hidden="true"><path d="M3 9 9 3M4 3h5v5" /></svg></a>
          </p>
        </div>
      </section>

      {rest.map((look, i) =>
        look.shot ? (
          <section class:list={["look", "look--shot", i % 2 === 0 ? "look--left" : "look--right"]} aria-labelledby={`look-${look.id}`} data-look>
            <figure class="plate reveal">
              <div class="plate__frame">
                <img class="plate__img plate__img--desktop" src={look.shot.desktop} alt={look.shot.alt} width="1920" height="1200" loading="lazy" />
                <img class="plate__img plate__img--mobile" src={look.shot.mobile} alt={look.shot.altMobile} width="780" height="1688" loading="lazy" />
              </div>
              <figcaption class="caption">
                <p class="label"><span class="caption__n">{n(i + 1)} / {total}</span> {look.kind} · {look.year}</p>
                <div class="views" role="group" aria-label={look.name}>
                  <button type="button" class="views__btn label" aria-pressed="true" data-view="desktop">{t.look.desktop}</button>
                  <button type="button" class="views__btn label" aria-pressed="false" data-view="mobile">{t.look.mobile}</button>
                </div>
              </figcaption>
            </figure>
            <div class="look__text">
              <h2 class="look__name display" id={`look-${look.id}`}>{look.name}</h2>
              <p class="look__body">{look.body}</p>
              <ul class="stack" aria-label="Stack">{look.stack.map((s) => <li>{s}</li>)}</ul>
              <p class="look__links">
                <a class="textlink" href={look.site} target="_blank" rel="noopener">{t.look.site}<svg class="arrow" viewBox="0 0 12 12" aria-hidden="true"><path d="M3 9 9 3M4 3h5v5" /></svg></a>
                <a class="textlink" href={look.repo} target="_blank" rel="noopener">{t.look.code}<svg class="arrow" viewBox="0 0 12 12" aria-hidden="true"><path d="M3 9 9 3M4 3h5v5" /></svg></a>
              </p>
            </div>
          </section>
        ) : (
          <section class="look look--type" aria-labelledby={`look-${look.id}`}>
            <h2 class="look__name look__name--wide display reveal" id={`look-${look.id}`}>{look.name}</h2>
            <p class="label look__meta"><span class="caption__n">{n(i + 1)} / {total}</span> {look.kind} · {look.year}</p>
            <div class="look__sheet">
              <p class="look__body">{look.body}</p>
              <dl class="facts">
                {look.facts!.map(([k, v]) => (
                  <div class="facts__row">
                    <dt class="label">{k}</dt>
                    <dd>{v}</dd>
                  </div>
                ))}
              </dl>
            </div>
            <div class="look__foot">
              <ul class="stack" aria-label="Stack">{look.stack.map((s) => <li>{s}</li>)}</ul>
              <a class="textlink" href={look.repo} target="_blank" rel="noopener">{t.look.code}<svg class="arrow" viewBox="0 0 12 12" aria-hidden="true"><path d="M3 9 9 3M4 3h5v5" /></svg></a>
            </div>
          </section>
        )
      )}

      <section class="index" id="indice" aria-labelledby="index-title">
        <div class="index__head">
          <h2 class="index__title display" id="index-title">{t.index.title}</h2>
          <p class="index__intro">{t.index.intro}</p>
        </div>
        <ol class="index__list">
          {t.index.rows.map((r) => (
            <li>
              <a class="index__row" href={r.href} target="_blank" rel="noopener">
                <span class="index__name">{r.name}</span>
                <span class="index__what">{r.what}</span>
                <span class="index__tech label">{r.tech}</span>
                <span class="index__year">{r.year}</span>
                <svg class="arrow" viewBox="0 0 12 12" aria-hidden="true"><path d="M3 9 9 3M4 3h5v5" /></svg>
              </a>
            </li>
          ))}
        </ol>
        <p class="index__all"><a class="textlink" href={links.github} target="_blank" rel="noopener">github.com/AlexisDaleiro<svg class="arrow" viewBox="0 0 12 12" aria-hidden="true"><path d="M3 9 9 3M4 3h5v5" /></svg></a></p>
      </section>

      <section class="about" aria-labelledby="about-title">
        <h2 class="about__title display" id="about-title">{t.about.title}</h2>
        <div class="about__body">{t.about.body.map((p) => <p>{p}</p>)}</div>
      </section>

      <section class="contact" id="contacto" aria-labelledby="contact-title">
        <h2 class="contact__title display" id="contact-title">{t.contact.title}</h2>
        <p class="contact__line">{t.contact.line}</p>
        <a class="contact__email display" href={`mailto:${links.email}`}>{links.email}</a>
        <ul class="contact__links">
          {hasCv && <li><a class="button button--inverse" href={links.cv} download>{t.hero.cv}</a></li>}
          <li><a class="textlink" href={links.linkedin} target="_blank" rel="noopener">LinkedIn<svg class="arrow" viewBox="0 0 12 12" aria-hidden="true"><path d="M3 9 9 3M4 3h5v5" /></svg></a></li>
          <li><a class="textlink" href={links.github} target="_blank" rel="noopener">GitHub<svg class="arrow" viewBox="0 0 12 12" aria-hidden="true"><path d="M3 9 9 3M4 3h5v5" /></svg></a></li>
        </ul>
        <p class="contact__foot label">© 2026 Alexis Daleiro · Uruguay</p>
      </section>
    </main>

    <script>
      // Each look shows its site on desktop; hover, focus or the toggle switch it to the phone view.
      for (const scope of document.querySelectorAll<HTMLElement>("[data-look], .hero")) {
        const plate = scope.querySelector<HTMLElement>(".plate") ?? (scope.classList.contains("plate") ? scope : null);
        const buttons = scope.querySelectorAll<HTMLButtonElement>(".views__btn");
        if (!plate || !buttons.length) continue;
        let pinned: string | null = null;
        const show = (view: string) => {
          plate.dataset.view = view;
          buttons.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.view === view)));
        };
        buttons.forEach((b) =>
          b.addEventListener("click", () => {
            pinned = b.dataset.view!;
            show(pinned);
          }),
        );
        if (matchMedia("(hover: hover)").matches) {
          plate.addEventListener("pointerenter", () => show("mobile"));
          plate.addEventListener("pointerleave", () => show(pinned ?? "desktop"));
        }
      }

      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add("is-in");
              io.unobserve(e.target);
            }
          }
        },
        { rootMargin: "0px 0px -12% 0px" },
      );
      document.querySelectorAll(".reveal").forEach((el) => io.observe(el));
    </script>

    <style>
      /* Nav: one hairline, few words */
      .nav {
        position: sticky;
        top: 0;
        z-index: 10;
        height: var(--nav-h);
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        padding: 0 var(--gutter);
        background: var(--ground);
        border-bottom: 1px solid var(--ink);
      }
      .nav__name {
        font: 400 1.375rem/1 var(--display);
        text-decoration: none;
        letter-spacing: -0.01em;
      }
      .nav__links {
        display: flex;
        gap: clamp(20px, 3vw, 48px);
      }
      .nav__links a,
      .nav__cv {
        font: 500 0.75rem/1 var(--text);
        letter-spacing: 0.12em;
        text-transform: uppercase;
        text-decoration: none;
        padding: 8px 0;
        background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat;
        transition: background-size 0.5s var(--ease);
      }
      .nav__links a:hover,
      .nav__cv:hover {
        background-size: 100% 1px;
      }
      .nav__end {
        justify-self: end;
        display: flex;
        align-items: center;
        gap: 28px;
      }
      .nav__lang {
        display: flex;
        gap: 6px;
        color: var(--ink-2);
      }
      .nav__lang [aria-current] {
        color: var(--ink);
      }
      .nav__lang a {
        text-decoration: none;
      }
      .nav__lang a:hover {
        color: var(--ink);
        text-decoration: underline;
      }

      /* Buttons and links */
      .button {
        display: inline-flex;
        align-items: center;
        min-height: 52px;
        padding: 0 28px;
        background: var(--ink);
        color: var(--ground);
        font: 500 0.8125rem/1 var(--text);
        letter-spacing: 0.12em;
        text-transform: uppercase;
        text-decoration: none;
        transition: background-color 0.4s var(--ease);
      }
      .button:hover {
        background: var(--accent);
      }
      .button--inverse {
        background: var(--ground);
        color: var(--ink);
      }
      .button--inverse:hover {
        background: var(--stone);
      }
      .textlink {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font: 500 0.8125rem/1 var(--text);
        letter-spacing: 0.12em;
        text-transform: uppercase;
        text-decoration: underline;
        text-decoration-thickness: 1px;
        text-underline-offset: 0.5em;
        padding: 12px 0;
        transition: color 0.3s var(--ease);
      }
      .textlink:hover {
        color: var(--accent);
      }
      .arrow {
        width: 0.75em;
        height: 0.75em;
        fill: none;
        stroke: currentColor;
        stroke-width: 1.4;
        flex: none;
        transition: transform 0.4s var(--ease);
      }
      a:hover .arrow {
        transform: translate(2px, -2px);
      }

      /* Plates: real screenshots are the only texture */
      .plate__frame {
        position: relative;
        aspect-ratio: 16 / 10;
        background: var(--paper);
        overflow: hidden;
      }
      .plate__img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        transition: opacity 0.9s var(--ease), transform 1.4s var(--ease);
      }
      .plate__img--desktop {
        object-fit: cover;
        object-position: top;
      }
      .plate__img--mobile {
        object-fit: contain;
        padding: 4% 0;
        opacity: 0;
        transform: translateY(2%);
        filter: drop-shadow(0 18px 30px rgb(17 17 18 / 0.18));
      }
      .plate[data-view="mobile"] .plate__img--desktop {
        opacity: 0;
        transform: scale(1.03);
      }
      .plate[data-view="mobile"] .plate__img--mobile {
        opacity: 1;
        transform: none;
      }
      :global(html.js) .reveal {
        clip-path: inset(0 0 100% 0);
        transition: clip-path 1.6s var(--ease);
      }
      :global(html.js) .reveal.is-in {
        clip-path: inset(0 0 0 0);
      }

      .caption {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        padding-top: 14px;
      }
      .caption__n {
        color: var(--ink-2);
        margin-right: 10px;
        font-variant-numeric: tabular-nums;
      }
      .views {
        display: flex;
        gap: 4px;
      }
      .views__btn {
        border: 1px solid transparent;
        background: none;
        color: var(--ink-2);
        min-height: 44px;
        padding: 0 14px;
        cursor: pointer;
        transition: color 0.3s var(--ease), border-color 0.3s var(--ease);
      }
      .views__btn:hover {
        color: var(--ink);
      }
      .views__btn[aria-pressed="true"] {
        color: var(--ink);
        border-color: var(--ink);
      }

      /* Hero: look 01 is the first viewport */
      .hero {
        min-height: calc(100svh - var(--nav-h));
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        grid-template-rows: auto auto auto;
        align-content: center;
        column-gap: 24px;
        padding: clamp(20px, 3vh, 40px) var(--gutter) clamp(20px, 3vh, 36px);
      }
      .plate--hero {
        grid-column: 5 / -1;
        grid-row: 1;
        align-self: start;
      }
      .plate--hero .plate__frame {
        aspect-ratio: auto;
        height: min(60svh, calc((100vw - 2 * var(--gutter)) * 0.66 * 0.56));
      }
      .plate--hero .plate__img--desktop {
        object-position: left top;
      }
      /* Keep the phone clear of the band the name crosses. */
      .plate--hero .plate__img--mobile {
        padding: 3% 0 18%;
      }
      .caption--hero {
        grid-column: 1 / 5;
        grid-row: 1;
        align-self: end;
        flex-direction: column;
        align-items: flex-start;
        padding: 0 0 calc(0.42 * clamp(3.75rem, 11.2vw, 11.5rem) + 48px);
      }
      /* The name crosses the plate's lower edge; difference keeps it legible on both ground and screenshot. */
      .hero__name {
        grid-column: 1 / -1;
        grid-row: 2;
        position: relative;
        z-index: 1;
        color: var(--ground);
        mix-blend-mode: difference;
        font-size: clamp(3.75rem, 11.2vw, 11.5rem);
        line-height: 0.82;
        letter-spacing: -0.035em;
        margin-top: -0.42em;
        white-space: nowrap;
      }
      .hero__copy {
        grid-column: 1 / -1;
        grid-row: 3;
        display: grid;
        grid-template-columns: minmax(0, 44ch) auto;
        justify-content: space-between;
        align-items: end;
        column-gap: 48px;
        row-gap: 12px;
        margin-top: clamp(24px, 3.4vh, 40px);
      }
      .hero__role {
        grid-column: 1;
        color: var(--ink);
      }
      .hero__line {
        grid-column: 1;
        color: var(--ink-2);
        font-size: 1.0625rem;
      }
      .hero__actions {
        grid-column: 2;
        grid-row: 1 / 3;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 12px 28px;
      }

      /* Looks */
      .look {
        padding: clamp(80px, 14vh, 160px) var(--gutter);
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        column-gap: 24px;
      }
      .look__name {
        font-size: clamp(3rem, 7vw, 6.5rem);
      }
      .look__body {
        max-width: 58ch;
        color: var(--ink-2);
      }
      .look__text {
        display: flex;
        flex-direction: column;
        gap: 24px;
      }
      .look__links {
        display: flex;
        gap: 28px;
      }
      .stack {
        display: flex;
        flex-wrap: wrap;
        gap: 8px 24px;
        font: 500 0.75rem/1.3 var(--text);
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }

      .look--detail {
        padding-top: clamp(48px, 9vh, 96px);
        border-top: 1px solid var(--stone);
        margin: 0 var(--gutter);
        padding-left: 0;
        padding-right: 0;
      }
      .look--detail .look__text {
        grid-column: 5 / 12;
      }

      .look--shot .plate {
        grid-row: 1;
      }
      .look--shot .look__text {
        grid-row: 1;
        align-self: end;
      }
      .look--left .plate {
        grid-column: 1 / 9;
      }
      .look--left .look__text {
        grid-column: 9 / -1;
      }
      .look--right .plate {
        grid-column: 5 / -1;
      }
      .look--right .look__text {
        grid-column: 1 / 5;
      }
      .look--shot .look__name {
        font-size: clamp(2.75rem, 5.4vw, 5.5rem);
      }

      .look--type {
        background: var(--paper);
        row-gap: 0;
      }
      .look--type + .look--type {
        border-top: 1px solid var(--stone);
      }
      .look__meta {
        grid-column: 1 / -1;
      }
      .look__name--wide {
        grid-column: 1 / -1;
        font-size: clamp(3.25rem, 12vw, 12rem);
        line-height: 0.85;
        letter-spacing: -0.04em;
        margin: 0 0 20px;
        overflow-wrap: anywhere;
      }
      .look--type .look__meta {
        margin-bottom: clamp(40px, 6vh, 72px);
      }
      .look__sheet {
        grid-column: 1 / -1;
        display: grid;
        grid-template-columns: subgrid;
        row-gap: 32px;
      }
      .look__sheet .look__body {
        grid-column: 1 / 6;
        color: var(--ink);
      }
      .facts {
        grid-column: 7 / -1;
        border-top: 1px solid var(--ink);
      }
      .facts__row {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
        gap: 16px;
        padding: 16px 0;
        border-bottom: 1px solid var(--stone);
      }
      .facts dt {
        color: var(--ink-2);
        padding-top: 0.3em;
      }
      .facts dd {
        font: 400 1.375rem/1.25 var(--display);
        font-variant-numeric: lining-nums;
      }
      .look__foot {
        grid-column: 1 / -1;
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        align-items: center;
        gap: 16px 32px;
        margin-top: 40px;
      }

      /* Index: the dense passage */
      .index {
        padding: clamp(96px, 16vh, 180px) var(--gutter) clamp(64px, 10vh, 120px);
      }
      .index__head {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        justify-content: space-between;
        gap: 12px 32px;
        margin-bottom: 40px;
      }
      .index__title {
        font-size: clamp(3rem, 7vw, 6.5rem);
      }
      .index__intro {
        color: var(--ink-2);
      }
      .index__list {
        border-top: 1px solid var(--ink);
      }
      .index__row {
        display: grid;
        grid-template-columns: 3fr 4fr 3fr 0.6fr auto;
        align-items: baseline;
        gap: 24px;
        padding: 20px 0;
        border-bottom: 1px solid var(--stone);
        text-decoration: none;
        transition: background-color 0.4s var(--ease), padding 0.5s var(--ease);
      }
      .index__row:hover {
        background: var(--paper);
        padding-left: 12px;
        padding-right: 12px;
      }
      .index__name {
        font: 400 1.625rem/1.1 var(--display);
      }
      .index__what {
        color: var(--ink-2);
      }
      .index__tech {
        color: var(--ink-2);
      }
      .index__year {
        font-variant-numeric: tabular-nums;
        color: var(--ink-2);
      }
      .index__all {
        margin-top: 24px;
      }

      .about {
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        column-gap: 24px;
        row-gap: 28px;
        padding: clamp(64px, 10vh, 120px) var(--gutter) clamp(96px, 16vh, 180px);
      }
      .about__title {
        grid-column: 1 / 5;
        font-size: clamp(2.5rem, 4.6vw, 4.25rem);
      }
      .about__body {
        grid-column: 6 / 12;
        display: flex;
        flex-direction: column;
        gap: 1.1em;
        font-size: 1.1875rem;
        max-width: 62ch;
      }

      /* Close: the page ends on ink */
      .contact {
        background: var(--ink);
        color: var(--ground);
        padding: clamp(96px, 16vh, 180px) var(--gutter) 40px;
        display: flex;
        flex-direction: column;
        gap: 28px;
      }
      .contact ::selection {
        background: var(--ground);
        color: var(--ink);
      }
      .contact :focus-visible {
        outline-color: var(--ground);
      }
      .contact__title {
        font-size: clamp(4rem, 13vw, 13rem);
        line-height: 0.82;
        letter-spacing: -0.04em;
      }
      .contact__line {
        color: #b9b8b2;
      }
      .contact__email {
        font-size: clamp(1.5rem, 4.4vw, 4rem);
        line-height: 1.1;
        text-decoration: underline;
        text-decoration-thickness: 1px;
        text-underline-offset: 0.18em;
        overflow-wrap: anywhere;
        width: fit-content;
        transition: color 0.3s var(--ease);
      }
      .contact__email:hover {
        color: #9cc3e2;
      }
      .contact__links {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 12px 32px;
        margin-top: 12px;
      }
      .contact .textlink:hover {
        color: #9cc3e2;
      }
      .contact__foot {
        margin-top: clamp(64px, 12vh, 140px);
        padding-top: 20px;
        border-top: 1px solid #3a3a38;
        color: #b9b8b2;
      }

      @media (max-width: 1024px) {
        .plate--hero {
          grid-column: 6 / -1;
        }
        .caption--hero {
          grid-column: 1 / 6;
        }
        .hero__copy {
          grid-template-columns: minmax(0, 1fr);
        }
        .hero__actions {
          grid-column: 1;
          grid-row: auto;
          margin-top: 12px;
        }
        .look--left .plate,
        .look--right .plate {
          grid-column: 1 / -1;
        }
        .look--left .look__text,
        .look--right .look__text {
          grid-column: 1 / -1;
          grid-row: 2;
          margin-top: 40px;
        }
        .look--detail .look__text {
          grid-column: 1 / -1;
        }
        .look__sheet .look__body,
        .facts {
          grid-column: 1 / -1;
        }
        .index__row {
          grid-template-columns: 1fr auto auto;
        }
        .index__what,
        .index__tech {
          grid-column: 1 / -1;
          grid-row: 2;
        }
        .index__tech {
          grid-row: 3;
        }
        .about__title,
        .about__body {
          grid-column: 1 / -1;
        }
      }

      @media (max-width: 720px) {
        .nav {
          grid-template-columns: 1fr auto;
        }
        .nav nav {
          display: none;
        }
        .hero {
          display: flex;
          flex-direction: column;
          min-height: 0;
          padding-top: 0;
        }
        .plate--hero {
          margin: 0 calc(-1 * var(--gutter));
          align-self: stretch;
          order: 1;
        }
        .plate--hero .plate__frame {
          height: auto;
          aspect-ratio: 2108 / 1180;
        }
        .caption--hero {
          order: 2;
          flex-direction: row;
          align-items: center;
          padding: 14px 0 0;
        }
        .hero__name {
          order: 3;
          margin-top: 28px;
          font-size: clamp(3.25rem, 17vw, 6rem);
          white-space: normal;
        }
        .hero__copy {
          order: 4;
          margin-top: 24px;
          max-width: none;
        }
        .caption {
          flex-wrap: wrap;
        }
        .look--shot .plate {
          margin: 0 calc(-1 * var(--gutter));
        }
        .look--shot .caption {
          padding-left: var(--gutter);
          padding-right: var(--gutter);
        }
        .index__row {
          gap: 8px 16px;
        }
      }
    </style>
  </body>
</html>
